{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "importOrder": [
    "<THIRD_PARTY_MODULES>",

    "^@/app/(.*)$",
    "^@/pages/(.*)$",
    "^@/features/(.*)$",
    "^@/api/(.*)$",

    "^@/shared/(.*)$",

    "^@/assets/(.*)$",

    "^../(.*)$",
    "^./(.*)$",

    "\\.(css|scss)$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ]
}
